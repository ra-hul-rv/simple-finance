# Database
DATABASE_URL="postgresql://simplefinance:simplefinance_secret@localhost:5432/simplefinance"
POSTGRES_USER=simplefinance
POSTGRES_PASSWORD=simplefinance_secret
POSTGRES_DB=simplefinance

# Auth.js
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Simple Finance"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Configuration (Local Ollama by default, or cloud API like Nvidia / OpenAI)
# Local Ollama:
AI_URL="http://host.docker.internal:11434/v1/chat/completions"
AI_KEY="ollama"
AI_MODEL="qwen2.5:3b"

# Optional Cloud fallback (e.g. Nvidia NIM):
# AI_URL="https://integrate.api.nvidia.com/v1/chat/completions"
# AI_KEY="Bearer nvapi-..."
# AI_MODEL="meta/llama-3.2-11b-vision-instruct"
