# Database
DATABASE_URL="postgresql://simplefinance:simplefinance_secret@localhost:5432/simplefinance"
POSTGRES_USER=simplefinance
POSTGRES_PASSWORD=simplefinance_secret
POSTGRES_DB=simplefinance

# Auth.js
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
